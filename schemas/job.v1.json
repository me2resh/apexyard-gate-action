{
  "$comment": "pinned copy; source: the ApexYard runner run-record decision at commit 1580a1f; runner schema file not yet published",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.v1.json",
  "title": "ApexYard job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "job_id",
    "entry_point",
    "repo",
    "issue",
    "issue_body_sha256",
    "base",
    "slice_id",
    "harness",
    "mode",
    "model",
    "team",
    "requested_by",
    "signed_in_as",
    "requested_at"
  ],
  "properties": {
    "v": { "const": 1 },
    "job_id": {
      "type": "string",
      "pattern": "^ayj-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "entry_point": {
      "enum": ["runner-click", "github-label", "slack", "vendor-trigger"]
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        }
      }
    },
    "issue": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "issue_body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "slice_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^slice-[a-z0-9][a-z0-9-]{0,79}$"
        }
      ]
    },
    "harness": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "mode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "team": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "pack_version", "pack_sha256"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "pack_version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "pack_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_id", "login", "source"],
      "properties": {
        "github_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        }
      }
    },
    "signed_in_as": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["github_id", "login"],
          "properties": {
            "github_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "login": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
            }
          }
        }
      ]
    },
    "requested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
