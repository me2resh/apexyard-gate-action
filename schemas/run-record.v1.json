{
  "$comment": "pinned copy; source: the ApexYard runner run-record decision at commit 1580a1f; runner schema file not yet published",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-record.v1.json",
  "title": "ApexYard run record",
  "description": "Maximum serialized size is 4096 bytes. The gate refuses a larger file. Every field is reported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "kind",
    "run_id",
    "job",
    "branch",
    "agdr_paths",
    "runner_version",
    "created_at"
  ],
  "properties": {
    "v": { "const": 1 },
    "kind": { "const": "apexyard.run-record" },
    "run_id": {
      "type": "string",
      "pattern": "^ayr-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "job": { "$ref": "job.v1.json" },
    "branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
    },
    "agdr_paths": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "pattern": "^docs/agdr/AgDR-[A-Za-z0-9._+-]+\\.md$"
      }
    },
    "runner_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
