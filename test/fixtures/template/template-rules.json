{
  "name": "template-rules",
  "file": "templates/apexyard-gate.yml",
  "relayFile": "templates/apexyard-gate-relay.yml",
  "uses": "me2resh/apexyard-gate@0000000000000000000000000000000000000000",
  "jobName": "apexyard-gate-evaluate",
  "forbiddenJobName": "ApexYard Gate",
  "permissions": {
    "contents": "read",
    "pull-requests": "read",
    "issues": "read"
  },
  "triggers": {
    "pull_request_target": [
      "opened",
      "reopened",
      "synchronize",
      "edited",
      "ready_for_review"
    ],
    "workflow_run": [
      "completed"
    ]
  },
  "mustInclude": [
    "on:",
    "  pull_request_target:",
    "    types: [opened, reopened, synchronize, edited, ready_for_review]",
    "  workflow_run:",
    "    workflows: [apexyard-gate-relay]",
    "    types: [completed]",
    "permissions:",
    "  contents: read",
    "  pull-requests: read",
    "  issues: read",
    "concurrency:",
    "  group: apexyard-gate-${{ github.event.pull_request.number || github.event.workflow_run.head_sha }}",
    "  cancel-in-progress: true",
    "  apexyard-gate-evaluate:",
    "    name: apexyard-gate-evaluate",
    "    environment: apexyard-gate",
    "        uses: me2resh/apexyard-gate@0000000000000000000000000000000000000000",
    "          token: ${{ github.token }}",
    "          app-id: ${{ secrets.APEXYARD_GATE_APP_ID }}",
    "          app-key: ${{ secrets.APEXYARD_GATE_APP_KEY }}"
  ],
  "mustNotInclude": [
    "actions/checkout",
    "actions/github-script",
    "checks: write",
    "statuses: write",
    "pull_request_review:",
    "github.head_ref",
    "name: ApexYard Gate"
  ]
}
